---
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Read the pre-generated statistics file (created by scripts/sync-data.mjs).
const statsPath = resolve(process.cwd(), 'public/videos/statistics.json');

type TopVideo = {
  video_id: string;
  title: string;
  channel: string;
  published_at: string;
  view_count: number;
  like_count: number;
  comment_count: number;
  url: string;
};

let topVideos: TopVideo[] = [];
let generatedAt: string | null = null;
try {
  const stats = JSON.parse(readFileSync(statsPath, 'utf-8'));
  topVideos = (stats.top_videos ?? []) as TopVideo[];
  generatedAt = stats.generated_at ?? null;
} catch {
  topVideos = [];
}

const numberFmt = new Intl.NumberFormat('de-DE');
const dateFmt = new Intl.DateTimeFormat('de-DE', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  timeZone: 'Europe/Berlin',
});
const generatedLabel = generatedAt
  ? new Intl.DateTimeFormat('de-DE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Berlin',
    }).format(new Date(generatedAt))
  : null;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}/favicon.svg`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Top 20 Videos · The Real Life Guys Zeitstrahl</title>
    <meta
      name="description"
      content="Die 20 meistgesehenen Videos der Real Life Guys Kanäle."
    />
  </head>
  <body class="min-h-screen antialiased">
    <!-- Ambient gradient background -->
    <div
      class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-40 left-1/2 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-red-600/20 blur-[120px]"
      >
      </div>
      <div
        class="absolute top-1/3 -left-40 h-96 w-96 rounded-full bg-indigo-600/10 blur-[120px]"
      >
      </div>
    </div>

    <!-- Header -->
    <header class="border-b border-white/5 backdrop-blur-sm">
      <div class="mx-auto max-w-3xl px-6 py-10 sm:py-14">
        <nav
          class="mb-8 flex items-center gap-2 text-sm"
          aria-label="Hauptnavigation"
        >
          <a
            href={`${base}/`}
            class="rounded-full px-4 py-1.5 font-medium text-slate-400 transition hover:bg-white/5 hover:text-white"
            >Zeitstrahl</a
          >
          <a
            href={`${base}/top20`}
            aria-current="page"
            class="rounded-full bg-white/10 px-4 py-1.5 font-medium text-white"
            >Top 20</a
          >
        </nav>
        <div class="flex items-center gap-3 text-sm text-red-400">
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"
            ></path>
          </svg>
          <span class="font-medium tracking-wide uppercase"
            >The Real Life Guys YouTube-Zeitstrahl</span
          >
        </div>
        <h1
          class="mt-4 text-4xl font-extrabold tracking-tight text-white sm:text-5xl"
        >
          Top 20 nach Aufrufen
        </h1>
        <p class="mt-3 max-w-xl text-slate-400">
          Die 20 meistgesehenen Videos über alle Kanäle hinweg.
        </p>
        {
          generatedLabel && (
            <p class="mt-2 text-sm text-slate-500">
              Stand: {generatedLabel}
            </p>
          )
        }
      </div>
    </header>

    <!-- Table -->
    <main class="mx-auto max-w-3xl px-6 py-10 pb-24">
      <div class="overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full min-w-[520px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-white/10 text-xs uppercase tracking-wide text-slate-400">
              <th class="px-4 py-3 font-semibold">#</th>
              <th class="px-4 py-3 font-semibold">Titel</th>
              <th class="px-4 py-3 font-semibold">Kanal</th>
              <th class="px-4 py-3 text-right font-semibold">Aufrufe</th>
            </tr>
          </thead>
          <tbody>
            {
              topVideos.map((video, i) => (
                <tr class="border-b border-white/5 transition last:border-0 hover:bg-white/[0.03]">
                  <td class="px-4 py-3 font-semibold text-slate-500 tabular-nums">
                    {i + 1}
                  </td>
                  <td class="px-4 py-3">
                    <a
                      href={video.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-white hover:text-red-400"
                    >
                      {video.title}
                    </a>
                    <span class="mt-0.5 block text-xs text-slate-500 tabular-nums">
                      {dateFmt.format(new Date(video.published_at))}
                    </span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-slate-400">
                    {video.channel}
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums">
                    <span class="font-medium text-white">
                      {numberFmt.format(video.view_count)}
                    </span>
                    <span class="mt-0.5 block text-xs text-slate-500">
                      {numberFmt.format(video.like_count)} Likes
                    </span>
                    <span class="block text-xs text-slate-500">
                      {numberFmt.format(video.comment_count)} Kommentare
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {
        topVideos.length === 0 && (
          <p class="mt-6 text-center text-sm text-slate-500">
            Keine Statistikdaten gefunden. Bitte zuerst{' '}
            <code class="rounded bg-white/10 px-1.5 py-0.5">npm run sync-data</code>{' '}
            ausführen.
          </p>
        )
      }
    </main>

    <footer class="border-t border-white/5">
      <div
        class="mx-auto max-w-3xl px-6 py-8 text-center text-sm text-slate-600"
      >
        Erstellt von <a
          href="https://www.youtube.com/@daniel-blaser-berg"
          class="text-slate-400 hover:text-white"
          target="_blank"
          rel="noopener noreferrer">@daniel-blaser-berg</a
        > und etwas KI · <a
          href="https://github.com/bladan/real-life-guys-timeline"
          class="inline-flex align-middle items-center gap-1 text-slate-500 hover:text-slate-300 transition"
          target="_blank"
          rel="noopener noreferrer"
          title="GitHub Repository"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          GITHUB Projektseite
        </a>
      </div>
    </footer>
  </body>
</html>
