{
  "name": "Astro Dev Container",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [4321],
  "containerEnv": {
    "YOUTUBE_API_KEY": "${localEnv:YOUTUBE_API_KEY}",
    "YOUTUBE_CHANNELS": "${localEnv:YOUTUBE_CHANNELS}"
  },
  "postCreateCommand": "bash -lc 'cd site && npm install'",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
